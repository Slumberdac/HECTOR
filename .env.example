# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Or, from the repository root, write them straight in without pasting:
#   for n in POSTGRES_PASSWORD JWT_SECRET; do
#     v=$(openssl rand -base64 36 | tr -d '/+=' | head -c 48)
#     sed -i "s|^$n=.*|$n=$v|" .env
#   done
#   unset v

# --- Database ----------------------------------------------------------------
# The stack runs FerretDB, which speaks the MongoDB wire protocol on top of
# PostgreSQL. These are the PostgreSQL credentials, and they are also what the
# API authenticates with: FerretDB has no user table of its own.
#
# MongoDB itself is not used because every release from 5.0 onward requires an
# ARMv8.2-A CPU, which the Pi 4 does not have.
POSTGRES_USER=hector
POSTGRES_PASSWORD=

# Image tags. These two are released in lockstep and the DocumentDB tag encodes
# the FerretDB version it belongs to, so bump them together.
FERRETDB_TAG=2.7.0
DOCUMENTDB_TAG=17-0.107.0-ferretdb-2.7.0

# --- API ---------------------------------------------------------------------
# Signs session tokens. At least 32 characters. Changing it signs everyone out.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Cost factor for password hashing. 12 is a reasonable floor; a Pi 4 takes
# roughly a third of a second per hash at that setting.
BCRYPT_ROUNDS=12

# --- Cloudflare Tunnel -------------------------------------------------------
# From the Zero Trust dashboard: Networks > Tunnels > your tunnel > install
# connector. This value is a credential; treat it like a password.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Local development only --------------------------------------------------
# Not used by docker-compose.yml. Copy these into backend/.env when running the
# API directly with `npm run dev`.
#   NODE_ENV=development
#   PORT=5000
#   MONGODB_URI=mongodb://hector:PASSWORD@localhost:27017/hector
#   JWT_SECRET=<any 32+ character string>
#   CORS_ORIGINS=
