# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- MongoDB -----------------------------------------------------------------
# Root account, used once to create the application user on first boot.
MONGO_ROOT_USERNAME=hector_root
MONGO_ROOT_PASSWORD=

# Least-privilege account the API actually connects with.
MONGO_APP_USERNAME=hector_app
MONGO_APP_PASSWORD=

# --- API ---------------------------------------------------------------------
# Signs session tokens. At least 32 characters. Changing it signs everyone out.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Cost factor for password hashing. 12 is a reasonable floor; a Pi 4 takes
# roughly a quarter of a second per hash at that setting.
BCRYPT_ROUNDS=12

# --- Cloudflare Tunnel -------------------------------------------------------
# From the Zero Trust dashboard: Networks > Tunnels > your tunnel > install
# connector. This value is a credential; treat it like a password.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Local development only --------------------------------------------------
# Not used by docker-compose.yml. Copy these into backend/.env when running the
# API directly with `npm run dev`.
#   NODE_ENV=development
#   PORT=5000
#   MONGODB_URI=mongodb://localhost:27017/hector
#   JWT_SECRET=<any 32+ character string>
#   CORS_ORIGINS=
