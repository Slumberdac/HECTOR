{
  "name": "@hector/api",
  "version": "2.0.0",
  "description": "HECTOR API, pet rock adoption registry",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "migrate:v1": "node scripts/migrate-from-v1.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:db": "node scripts/check-database.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0"
  }
}
