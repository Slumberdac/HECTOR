# Caddy runs *inside* the container on plain HTTP. TLS and the public hostname
# are handled by Cloudflare at the edge, and cloudflared reaches this over the
# private docker network — so nothing here needs a certificate.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv

	encode zstd gzip

	header {
		# Clickjacking, MIME sniffing and referrer leakage.
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"

		# The app loads nothing from third parties, so the policy can be tight.
		# `img-src` allows remote URLs because companion photos are user-supplied
		# links.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

		# Hashed asset filenames are immutable; index.html must never be cached
		# or a deploy would not reach anyone.
		?Cache-Control "public, max-age=3600"
		-Server
	}

	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@html path / /index.html
	header @html Cache-Control "no-cache"

	# Same-origin API. This is what lets the session cookie be SameSite=strict
	# and removes CORS from the picture entirely.
	handle /api/* {
		reverse_proxy api:5000
	}

	# Client-side routing: unknown paths fall back to the SPA shell.
	handle {
		try_files {path} /index.html
		file_server
	}
}
